# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Base URL for all API requests. Keep the `/api` prefix when using the mock
# API. Point this at your real backend to go live.
VITE_API_URL=/api

# When "true", the browser mock server (MSW) intercepts every request so the
# app runs with zero backend infrastructure.
# Set to "false" in production builds that talk to a real API.
VITE_ENABLE_MOCK_API=true

# Demo accounts used by the mock auth handler (comma-separated).
VITE_DEMO_ACCOUNTS=admin@vantage.dev / admin@vantage.dev
